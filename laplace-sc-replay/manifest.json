{
  "manifest_version": 3,
  "name": "LAPLACE SC 转发",
  "version": "0.3.2",
  "description": "从 LAPLACE Chat 控制台把醒目留言转为普通弹幕。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "optional_permissions": ["cookies"],
  "incognito": "spanning",
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://login-sync.laplace.cn/*",
    "https://api.bilibili.com/*",
    "https://api.live.bilibili.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "web_accessible_resources": [
    {
      "resources": ["account.html"],
      "matches": ["https://chat.laplace.live/*", "https://laplace.chat/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.laplace.live/dashboard/*",
        "https://laplace.chat/dashboard/*"
      ],
      "js": ["message-format.js", "recent-chat.js", "content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
